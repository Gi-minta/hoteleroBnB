# Variables de entorno del cliente (Vite). Cópialo a `.env` para desarrollo
# local, o defínelas como "Repository variables" en GitHub para el build de Pages.

# URL base de la API. Si se deja vacía, Axios usa "/api" y en dev el proxy de
# Vite lo redirige a http://localhost:3001. En producción (GitHub Pages) el
# cliente y el backend están en orígenes distintos, así que apunta a la URL
# pública del backend, p. ej.:
#   VITE_API_URL="https://mi-backend.example.com/api"
VITE_API_URL=""

# Prefijo de ruta base para el build (subdirectorio de GitHub Pages).
# Solo se usa en `vite build`; en dev siempre es "/". Debe empezar y terminar
# con "/". Por defecto es "/hoteleroBnB/".
VITE_BASE="/hoteleroBnB/"
